# Alias of the project, must exist in the database already
project_alias: str = ""        # e.g. "my_project"


# Path where the folders are stored (no trailing slash)
project_datastorage: str = ""  # e.g. "/data/ingest"


# Are md5 files required to check the files in a folder?
md5_required: bool = True
md5_file: str = ".md5"


# Temp folder, usually /tmp (no trailing slash)
tmp_folder: str = "/tmp"


# File types
main_files: str = ".tif"
raw_files: str = ".eip"
data_files: str | None = None     # e.g. ".xml" — extra allowed file types


# API location
api_url: str = ""   # e.g. "http://dashboard.example.com/api"
api_key: str = ""   # API key for the dashboard


# How many parallel processes to run
num_workers: int = 2

# Max concurrent API POSTs when flushing worker results
api_workers: int = 8

# Max concurrent Deep Zoom tile pyramids across worker processes (0 = unlimited)
zoom_workers: int = 4


# Validate filename sequences. Files are split by sequence_split, and the last
# segment is checked against this ordered list.
# e.g. sequence=['a','b','c'] with sequence_split='_' means files named
# "page_a", "page_b", "page_c" form a valid sequence — missing suffixes are flagged.
sequence_split: str = "_"
sequence: list[str] = []


# Path for programs in the system
jhove: str = "jhove"
exiftool: str = "exiftool"
identify_path: str = "identify"


# Path of where to save the JPG previews (no trailing slash)
jpg_previews: str = ""
# How much space to leave free, in decimal (0.1 is 10%).
#  If the free space left is less than this, the script will stop.
jpg_previews_free: float = 0.1


# Max threads for ImageMagick identify (MAGICK_THREAD_LIMIT env var)
magick_limit: int = 4


# Are previews hosted on this machine?
previews_local: bool = True

# Archive Deep Zoom tiles into a single {file_id}_files.tar and remove the
#  tiles folder. Only needed in rare cases (e.g. previews served elsewhere);
#  leave False to keep tiles as regular folders.
tar_previews: bool = False

# Regenerate previews even when outputs already exist
regenerate_previews: bool = False

# Generate Deep Zoom (.dzi + tiles) previews for dashboard zoom UI
deepzoom_previews: bool = False

# Write previews via temp dir then move (True) or in-place under jpg_previews (False)
preview_staging: bool = False

# Generate full-resolution JPEG at preview base root ({stem}.jpg)
fullsize_jpg: bool = True

# Log per-phase elapsed times (diagnostic)
profile_timing: bool = False


# Generate UUIDv4 for file and folder IDs instead of auto-increment integers
# Set to True when the dashboard API supports UUIDv4 IDs
uuid_ids: bool = False



